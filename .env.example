# Copy to .env and fill in. Never commit .env.

# FalkorDB: localhost for local runs, "falkordb" inside docker compose,
# or the FalkorDB Cloud host for the live demo.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FalkorDB Cloud: host without the port, plus the username and password from the instance's
# connection details. Leave both empty for local Docker.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Host port docker compose publishes FalkorDB on. If another Redis already uses 6379
# (a local redis-server answers "unknown command 'GRAPH.LIST'"), set both this and
# FALKORDB_PORT to 6380.
FALKORDB_HOST_PORT=6379

# LLM used for wording only (villager dialogue, intent parsing, detective).
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Seeded game: the same seed always gives the same village. seed.py runs the pre-game
# gossip with it, so run scripts/seed.py again after changing it.
GAME_SEED=42

# Live games kept at once; creating one more deletes the game seen least recently.
# FalkorDB Cloud's 100 MB tier fits about 5 (templates ~21 MB, ~14 MB per game).
MAX_GAMES=5

# 1 = keyword parser + template answers, so replay_demo.py is fully deterministic.
REPLAY=0
